# PureProtX Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it's already in .gitignore

# Purechain Private Key (required for blockchain operations)
# Get this from your Purechain wallet
TEST_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Optional: Custom RPC endpoint (defaults to https://purechainnode.com:8547)
# PURECHAIN_RPC_URL=https://purechainnode.com:8547

# Optional: Custom contract address
# CONTRACT_ADDRESS=0xabcdef1234567890...

# Optional: Network configuration
# NETWORK=testnet

# Development settings
# DEBUG=false
